# Settings for the example production stack. Copy to deploy/.env and fill in.
# deploy/.env is ignored by git. Never commit real values.
# Guide: docs/DEPLOYMENT.md

# --- The stack --------------------------------------------------------------

# The host name people and GitHub use, without https://. Its DNS must point at this machine and
# ports 80 and 443 must be reachable, so that a certificate can be issued.
SITE_ADDRESS=buddy.example.com

# A password for the database, made up by you. Letters and digits only, because it becomes part
# of a URL. For example: openssl rand -hex 24
POSTGRES_PASSWORD=

# Only with deploy/compose.image.yaml: the published API image to run, best by digest. Leave it
# out to build the image on this machine. See docs/DEPLOYMENT.md, section 3.
# PR_BUDDY_IMAGE=ghcr.io/<owner>/pr-buddy-api@sha256:<digest>

# --- GitHub App (required) --------------------------------------------------

GITHUB_APP_ID=
# On one line, with \n in place of each line break.
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- Dashboard (optional: set all three, or none) ---------------------------

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# The site address as a URL. Sign-in and cookies are built from it.
# PUBLIC_URL=https://buddy.example.com
# Optional. The app's name in https://github.com/apps/<name>: the first page then offers an
# "Install on GitHub" button.
# GITHUB_APP_SLUG=
# Optional. Who runs this deployment, shown on the public /privacy page. Without the first two
# the page says that the operator has not published who they are.
# OPERATOR_NAME=
# An email address, or an https:// address of a contact page.
# OPERATOR_CONTACT=
# Links to your own privacy policy and terms, if you have them.
# OPERATOR_PRIVACY_URL=
# OPERATOR_TERMS_URL=

# --- AI review (optional) ---------------------------------------------------
# See .env.example in the repository root for every provider.

# AI_PROVIDER=
# AI_MODEL=

# --- Data ------------------------------------------------------------------

# Days to keep reviews. Older ones are deleted at start-up and daily. 0 keeps everything.
# REVIEW_RETENTION_DAYS=365

# Lets customers store their own AI provider and key on the dashboard. 32 random bytes in
# base64, for example from: openssl rand -base64 32. Stored keys cannot be read without it.
# SECRETS_ENCRYPTION_KEY=
