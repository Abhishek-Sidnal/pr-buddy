# Settings for the example production stack. Copy to deploy/.env and fill in.
# deploy/.env is ignored by git. Never commit real values.
# Guide: docs/DEPLOYMENT.md

# --- The stack --------------------------------------------------------------

# The host name people and GitHub use, without https://. Its DNS must point at this machine and
# ports 80 and 443 must be reachable, so that a certificate can be issued.
SITE_ADDRESS=buddy.example.com

# A password for the database, made up by you. Letters and digits only, because it becomes part
# of a URL. For example: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- GitHub App (required) --------------------------------------------------

GITHUB_APP_ID=
# On one line, with \n in place of each line break.
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- Dashboard (optional: set all three, or none) ---------------------------

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# The site address as a URL. Sign-in and cookies are built from it.
# PUBLIC_URL=https://buddy.example.com

# --- AI review (optional) ---------------------------------------------------
# See .env.example in the repository root for every provider.

# AI_PROVIDER=
# AI_MODEL=
