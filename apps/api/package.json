{
  "name": "@pr-buddy/api",
  "version": "0.4.0",
  "private": true,
  "description": "HTTP service that receives GitHub webhooks and runs PR Buddy reviews.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "register-app": "node dist/cli/register-app.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@pr-buddy/ai-reviewer": "0.4.0",
    "@pr-buddy/github-client": "0.4.0",
    "@pr-buddy/review-engine": "0.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1"
  }
}
