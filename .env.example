# Copy this file to .env and fill in the three required values.
# .env is ignored by git. Never commit real values, and never put them in this file.
# How to obtain them: docs/GITHUB_APP.md

# --- Required ---------------------------------------------------------------

# Numeric ID shown at the top of your GitHub App's settings page.
GITHUB_APP_ID=

# The app's private key, on one line, with \n in place of each line break.
# Example shape: -----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----
GITHUB_PRIVATE_KEY=

# The webhook secret you entered when registering the app. At least 16 characters.
GITHUB_WEBHOOK_SECRET=

# --- Optional: database -----------------------------------------------------

# Without this the service keeps no review history and remembers webhook deliveries in memory.
# `docker compose` sets it for you to the local development database.
# For a database on another network, add ?sslmode=require or stronger.
# DATABASE_URL=postgres://user:password@host:5432/prbuddy
# DATABASE_POOL_SIZE=5

# --- Optional (defaults shown) ----------------------------------------------

# PORT=3000
# LOG_LEVEL=info
# Number of reverse proxies in front of the API. Leave at 0 when it is reached directly.
# TRUST_PROXY=0
# REVIEW_CONCURRENCY=2
# REVIEW_QUEUE_LIMIT=100
# Webhook requests allowed per minute from one client address.
# WEBHOOK_RATE_LIMIT=300

# --- Optional: dashboard ----------------------------------------------------

# Sign-in with GitHub and a read-only view of the review history. Needs DATABASE_URL and all
# three of these; setting only some stops the service at start-up. Steps: docs/GITHUB_APP.md
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# The address people open in a browser. https:// unless it is http://localhost.
# PUBLIC_URL=http://localhost:3000
