# Copy this file to .env and fill in the three required values.
# .env is ignored by git. Never commit real values, and never put them in this file.
# How to obtain them: docs/GITHUB_APP.md

# --- Required ---------------------------------------------------------------

# Numeric ID shown at the top of your GitHub App's settings page.
GITHUB_APP_ID=

# The app's private key, on one line, with \n in place of each line break.
# Example shape: -----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----
GITHUB_PRIVATE_KEY=

# The webhook secret you entered when registering the app. At least 16 characters.
GITHUB_WEBHOOK_SECRET=

# --- Optional: database -----------------------------------------------------

# Without this the service keeps no review history and remembers webhook deliveries in memory.
# `docker compose` sets it for you to the local development database.
# For a database on another network, add ?sslmode=require or stronger.
# DATABASE_URL=postgres://user:password@host:5432/prbuddy
# DATABASE_POOL_SIZE=5
# Days to keep reviews. Older ones are deleted at start-up and daily. 0 keeps everything.
# REVIEW_RETENTION_DAYS=365

# --- Optional (defaults shown) ----------------------------------------------

# PORT=3000
# LOG_LEVEL=info
# Number of reverse proxies in front of the API. Leave at 0 when it is reached directly.
# TRUST_PROXY=0
# REVIEW_CONCURRENCY=2
# REVIEW_QUEUE_LIMIT=100
# Webhook requests allowed per minute from one client address.
# WEBHOOK_RATE_LIMIT=300

# --- Optional: dashboard ----------------------------------------------------

# Sign-in with GitHub and a read-only view of the review history. Needs DATABASE_URL and all
# three of these; setting only some stops the service at start-up. Steps: docs/GITHUB_APP.md
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# The address people open in a browser. https:// unless it is http://localhost.
# PUBLIC_URL=http://localhost:3000

# --- Optional: AI review ----------------------------------------------------

# Off unless AI_PROVIDER is set. A repository must also opt in with
# "ai": { "enabled": true } in its .github/pr-buddy.json. When both are true, the title,
# description and visible diff lines of its pull requests are sent to the provider below.
# Details and limits: docs/DESIGN-AI.md
#
# One of: bedrock, anthropic, openai, azure, openai-compatible
# AI_PROVIDER=
# The model to use. Required; there is no default, because the model decides the cost.
# AI_MODEL=

# bedrock: the region, and either an access key ...
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# ... or a Bedrock API key:
# AWS_BEARER_TOKEN_BEDROCK=

# anthropic, openai, azure (and openai-compatible, if the server wants one):
# AI_API_KEY=

# azure: https://<resource>.openai.azure.com/openai/v1, with AI_MODEL set to the deployment name.
# openai-compatible: the server's address up to /v1. http:// is accepted for this machine only.
# AI_BASE_URL=

# Milliseconds to wait for the model. Default 60000.
# AI_TIMEOUT_MS=60000
